# Copy this file to .env and replace the placeholder values.
# Generate passwords with: openssl rand -hex 24
# Values with $, " #" or spaces must be wrapped in single quotes (see DEPLOYMENT.md).
MYSQL_ROOT_PASSWORD=replace-with-a-strong-password
MYSQL_PASSWORD=replace-with-another-strong-password

# WebSocket address of the game server as the player's browser sees it.
# Local use: ws://localhost:3001   Public server: e.g. wss://kpl.example.com/ws
VITE_SERVER_URL=ws://localhost:3001
